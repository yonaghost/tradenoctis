# Copy to .env.local for local development. Never commit real secrets.

# Translation backend selection: google-cloud | libretranslate | (unset -> demo fallback)
TRANSLATION_PROVIDER=

# Required if TRANSLATION_PROVIDER=google-cloud
GOOGLE_TRANSLATE_API_KEY=

# Required if TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional: override where Tesseract.js fetches trained-data language packs from,
# and where it caches them on disk after the first download.
TESSDATA_URL=
TESSDATA_CACHE_DIR=.cache/tessdata

# Optional: languages tried when no script/language hint is available at all.
OCR_FALLBACK_LANGS=eng+por

# Optional: explicit path to a Chromium binary for PDF export (Playwright).
PLAYWRIGHT_CHROMIUM_PATH=

# Optional: override the "Baixar aplicativo" APK link (defaults to the
# latest GitHub Release APK produced by CI).
NEXT_PUBLIC_NOCTIS_APK_URL=
